# ==============================================================================
# MOTEL MANAGEMENT SYSTEM - ROOT .GITIGNORE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OS & IDE Configuration Files
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans

# Visual Studio Code
.vscode/
*.code-workspace

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/
.nb-gradle/

# ------------------------------------------------------------------------------
# 2. Backend (Java / Maven / Spring Boot)
# ------------------------------------------------------------------------------
# Compiled class files and packages
backend/target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar

# Maven logs and crash reports
backend/*.log
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# 3. Frontend (React / Vite / TypeScript / Node.js)
# ------------------------------------------------------------------------------
# Dependencies
frontend/node_modules/
**/node_modules/
.pnp
.pnp.js

# Production build outputs
frontend/dist/
frontend/build/
**/dist/
**/build/

# Vite & Next cache
frontend/.vite/
**/.vite/

# NPM / Yarn / PNPM debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local environment overrides
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ------------------------------------------------------------------------------
# 4. Environment & Sensitive Data
# ------------------------------------------------------------------------------
.env
.env*.local
!.env.example

# ------------------------------------------------------------------------------
# 5. Temporary & Scratch Files
# ------------------------------------------------------------------------------
scratch/
tmp/
temp/
*.tmp
*.bak
*.swp
*~
